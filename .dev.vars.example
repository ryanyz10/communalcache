# Copy to .dev.vars (gitignored). Generate a fresh local-only auth secret there.
APP_BASE_URL=http://localhost:8787
BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=
# Google is hidden unless both values exist. Client ID is public; secret stays local.
GOOGLE_CLIENT_ID=590020154161-97ja6t1utnkdndn0kshrg5qutgjaobml.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# Registered local OAuth callback: http://localhost:8787/api/auth/callback/google
# Use localhost:8787 for Google; the Vite :5173 origin is not a registered callback.
# Local-only opt-in: terminal sign-in mail, public Turnstile testing-key verdicts.
# Never put LOCAL_DEV_AUTH in wrangler.jsonc or staging/production vars.
LOCAL_DEV_AUTH=1
RESEND_API_KEY=
EMAIL_FROM=Communal Cache <signin@send.communalcache.com>
# Optional local-only VAPID P-256 pair, never production keys. Leave blank to disable push UI.
# Public key: base64url uncompressed 65-byte point. Private key: base64url JWK d scalar.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# For Vite development, change BOTH URLs above to http://localhost:5173.
# Public Cloudflare always-pass TEST keys, not deployment credentials.
# Siteverify still runs. Its testing-key metadata is accepted only with the
# explicit local opt-in AND an actual localhost/127.0.0.1/[::1] request URL.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAMES=localhost
# Official source: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# Without local mode, real widget/Resend credentials need separate approval.
