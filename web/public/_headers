# Assets can bypass the user Worker. Keep these values aligned with src/http.ts.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), fullscreen=(), clipboard-write=(self), web-share=(self)
  Referrer-Policy: strict-origin-when-cross-origin

# Host-scoped HSTS deliberately excludes localhost and does not cover subdomains.
https://communalcache.com/*
  Strict-Transport-Security: max-age=31536000
https://communalcache-staging.ryanyz10-be6.workers.dev/*
  Strict-Transport-Security: max-age=31536000
